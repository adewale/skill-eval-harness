{
  "version": 2,
  "skill_name": "demo-reviewer",
  "skill_paths": [
    "skills/demo/SKILL.md"
  ],
  "variants": [
    "with_skill",
    "without_skill"
  ],
  "cases": [
    {
      "id": "c-review-verdict",
      "split": "tune",
      "kind": "review",
      "prompt": "Review this change: it adds a new HTTP endpoint with no test. Give me your review. End with a one-line verdict.",
      "assertions": [
        {
          "name": "severity-exact",
          "type": "contains",
          "value": "Severity: Blocking",
          "ci": false
        },
        {
          "name": "verdict-line",
          "type": "regex",
          "pattern": "(?m)^Verdict: (APPROVE|REQUEST CHANGES)",
          "ci": false
        }
      ]
    }
  ],
  "ablations": []
}
