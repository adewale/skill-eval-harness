{
  "detector": "tool_call",
  "cases": [
    {
      "note": "no matching call: a mention in tool OUTPUT must not count (inputs, not outputs)",
      "assertion": {"type": "tool_call", "tool": "bash", "pattern": "pytest"},
      "output": "done",
      "files": {"events.json": {"schema_version": 1, "source": "fixture", "events": [{"type": "command", "command": "ls -la", "status": "completed"}, {"type": "tool_result", "output_summary": "you should run pytest"}]}}
    },
    {
      "note": "reversed order fails the ordered form",
      "assertion": {"type": "tool_call", "order": ["git add", "git commit"]},
      "output": "done",
      "files": {"events.json": {"schema_version": 1, "source": "fixture", "events": [{"type": "command", "command": "git commit -m x", "status": "completed"}, {"type": "command", "command": "git add -A", "status": "completed"}]}}
    },
    {
      "note": "over max_count fires",
      "assertion": {"type": "tool_call", "tool": "bash", "pattern": "curl", "max_count": 1},
      "output": "done",
      "files": {"events.json": {"schema_version": 1, "source": "fixture", "events": [{"type": "command", "command": "curl a", "status": "completed"}, {"type": "command", "command": "curl b", "status": "completed"}]}}
    }
  ]
}
