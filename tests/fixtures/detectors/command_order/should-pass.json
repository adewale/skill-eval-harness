{
  "detector": "command_order",
  "cases": [
    {
      "note": "required order holds with interleaved unrelated commands",
      "assertion": {
        "type": "command_order",
        "patterns": [
          "git add",
          "git commit"
        ]
      },
      "output": "done",
      "files": {
        "events.json": {
          "schema_version": 1,
          "source": "fixture",
          "events": [
            {
              "type": "command",
              "command": "git add -A",
              "status": "completed"
            },
            {
              "type": "command",
              "command": "git status",
              "status": "completed"
            },
            {
              "type": "command",
              "command": "git commit -m x",
              "status": "completed"
            }
          ]
        }
      }
    }
  ]
}
